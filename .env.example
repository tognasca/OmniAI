# Copy this file to .env and fill in your values
# NEVER commit .env to git

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# WhatsApp / Meta Cloud API
WA_VERIFY_TOKEN=omni_whatsapp_verify_2026_CHANGE_ME
# These are stored encrypted in DB — set at startup
# WA_ACCESS_TOKEN is per-number, configured via dashboard

# AES-256 encryption for access tokens at rest
# Generate: openssl rand -base64 32  (Key)
# Generate: openssl rand -base64 16  (IV)
AES_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
AES_IV=REPLACE_WITH_BASE64_ENCODED_16_BYTE_IV

# Database (used by docker-compose)
SA_PASSWORD=YourStrong!Passw0rd

# Auth (JWT)
AUTH_AUTHORITY=https://your-auth-provider.com
AUTH_AUDIENCE=omni-ai-api
